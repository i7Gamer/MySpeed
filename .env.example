# MySpeed environment variables. Copy this file to .env and fill in what you need — everything below has a working default except the MySQL credentials.

# ---- Server ----

# HTTP listen port.
SERVER_PORT=5216

# HTTPS listen port, used only when data/certs holds a certificate.
HTTPS_PORT=5217

# Redirect network callers to the HTTPS listener when a certificate is present. Only the literal value "false" turns this off.
HTTPS_REDIRECT=true

# Serve the whole application from a subdirectory, e.g. /internet_speed, for a proxy that routes on a path prefix without stripping it off. Leave unset to serve from the root.
#BASE_PATH=

# ---- Security ----

# The four variables below each widen what an instance exposes. Read the README's "What is protected, and what is not" section before changing any of them from their default.

# Number of proxies in front of MySpeed (e.g. 1), or a preset such as "loopback". Required behind a reverse proxy so rate limiting and the login throttle see real client addresses instead of the proxy's own. Setting this trusts the X-Forwarded-For header from the configured hop count.
#TRUST_PROXY=

# CSP frame-ancestors value, controlling which origins may embed MySpeed in an iframe. The default blocks all embedding; opening this allows clickjacking from whatever origins you list. Left unset here on purpose: the default is the literal five characters 'none' including the quotes, and most env-file loaders (docker compose, systemd) strip matching quotes, which would turn it into a host named none. Set it only to a space-separated source list, e.g. https://dashboard.example.net
#FRAME_ANCESTORS=

# Header carrying a reverse proxy's asserted identity (e.g. Remote-User from Authelia or Authentik). When set, a request carrying this header is admitted as the operator without a password. Only takes effect together with TRUSTED_AUTH_PROXIES, and requires the proxy to strip this header from incoming requests.
#TRUSTED_AUTH_HEADER=

# Comma-separated addresses/CIDRs allowed to assert the TRUSTED_AUTH_HEADER identity, e.g. 172.18.0.5,10.0.0.0/8. Checked against the connecting socket. Without this, header authentication stays off regardless of TRUSTED_AUTH_HEADER.
#TRUSTED_AUTH_PROXIES=

# Serve a password-less instance to anyone who can reach it. Only safe on a trusted LAN.
ALLOW_NO_PASSWORD=false

# Permit remote nodes to be registered on loopback or link-local addresses. Off by default so a node URL cannot be used to probe the host or its local network.
ALLOW_LOCAL_NODES=false

# Comma-separated host allowlist for remote nodes, each with an optional port, e.g. 192.168.1.50,myspeed.example.net:5216. Empty (the default) permits any host that is not otherwise blocked. Worth setting on an instance reachable from the internet.
ALLOWED_NODE_HOSTS=

# ---- Database ----

# Database backend: "sqlite" or "mysql".
DB_TYPE=sqlite

# MySQL host. Ignored when DB_TYPE is sqlite.
DB_HOST=localhost

# MySQL port. Ignored when DB_TYPE is sqlite.
DB_PORT=3306

# MySQL database name. Required when DB_TYPE is mysql.
#DB_NAME=

# MySQL user. Required when DB_TYPE is mysql.
#DB_USER=

# MySQL password. Required when DB_TYPE is mysql. No example value — never commit a real password here.
#DB_PASS=

# ---- Preview / testing ----

# Run as a read-only public demo. Also switches the sqlite file to storage_preview.db so a preview instance never touches real data.
PREVIEW_MODE=false

# Banner text shown to visitors while PREVIEW_MODE is on.
PREVIEW_MESSAGE="The owner of this instance has not provided a message"

# Run a speedtest immediately on boot, instead of waiting for the first scheduled run.
RUN_TEST_ON_STARTUP=false

# ---- Image-level (set in the Dockerfile, not read by application code) ----

#TZ=Etc/UTC
#NODE_ENV=production
