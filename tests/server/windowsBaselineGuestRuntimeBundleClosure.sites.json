            "openDatabase = async (file) => process.versions.bun ? import(\"bun:sqlite\").then(({Database}) => { const database = new Database(file, {readonly: true, create: false, strict: true}); return { all: (sql, ...values) => database.query(sql).all(...values), close: () => database.close() }; }) : import(\"node:sqlite\").then(({DatabaseSync}) => { const database = new DatabaseSync(file, {readOnly: true}); return { all: (sql, ...values) => database.prepare(sql).all(...values), close: () => database.close() }; })",
